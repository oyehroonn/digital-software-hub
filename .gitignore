# Migrated WooCommerce customer PII — never in the public repo (lives only in the private admin repo)
admin-app/public/legacy/
woo-export/

# Internal infra/API access notes (real credentials — SSH passwords, API keys,
# tokens) rendered by the admin "Internal Docs" view. The digital-software-hub
# repo is PUBLIC, so these never get committed even though the view itself is
# gated behind Cloudflare Access at /admin — same treatment as public/legacy/
# above. Populate locally for dev (cp the Cherry notes in), stripped from the
# public build by build:admin.
admin-app/public/internal-notes/

# Admin app built into the store deploy (generated by build:admin)
public/admin/

